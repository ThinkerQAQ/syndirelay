{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.201",
  "key": "",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "cookies",
    "webRequest",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.cnblogs.com/*",
    "https://*.juejin.cn/*",
    "https://*.csdn.net/*",
    "https://*.segmentfault.com/*",
    "https://*.zhihu.com/*",
    "https://*.51cto.com/*",
    "https://*.oschina.net/*",
    "https://*.toutiao.com/*",
    "https://dev.to/*",
    "https://medium.com/*",
    "https://hashnode.com/*",
    "http://127.0.0.1:32146/*",
    "https://cnblogs.com/*",
    "https://juejin.cn/*",
    "https://csdn.net/*",
    "https://segmentfault.com/*",
    "https://zhihu.com/*",
    "https://51cto.com/*",
    "https://oschina.net/*",
    "https://toutiao.com/*",
    "https://search.google.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "action": {
    "default_title": "__MSG_openPanel__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:32146/console/*"
      ],
      "js": [
        "console-relay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "default_locale": "en"
}
