{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.19.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.24.5",
    "nodejs@22",
    "python@3.12"
  ],
  "shell": {
    "scripts": {
      "setup": [
        "npm ci"
      ],
      "test": [
        "npm test"
      ],
      "build": [
        "mkdir -p .build && CGO_ENABLED=0 go build -trimpath -o .build/syndirelay ./cmd"
      ],
      "verify-package": [
        "python3 scripts/test_package_installer.py"
      ]
    }
  }
}
