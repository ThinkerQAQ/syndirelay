   </widget></item>
   <item><widget class="QCheckBox" name="openExtensionCheckBox">
    <property name="text"><string>Set up the Chrome / Edge extension</string></property>
    <property name="checked"><bool>false</bool></property>
   </widget></item>
   <item><widget class="QLabel" name="extensionInstructions">
    <property name="text"><string>The extension is optional. Setup opens its folder and your browser's extensions page. Enable Developer mode, choose Load unpacked, then select that folder.</string></property>
